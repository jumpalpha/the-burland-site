{
  "name": "the-burland-site",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "images": "node scripts/optimize-images.mjs",
    "dev": "npm run images && next dev",
    "build": "npm run images && next build && node scripts/legacy-redirects.mjs && node scripts/flatten-rsc.mjs",
    "start": "npx serve out",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
